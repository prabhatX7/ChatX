# Copy to .env and fill in (or run:  node scripts/make-env.mjs you@example.com  from the project folder).
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/chatx

# Long random string (32+ chars). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# The account with this email is the ADMIN. The admin creates the group codes, approves sign-ups and message
# requests, and can message anyone.
ADMIN_EMAIL=

# A secret only you know (8+ chars). Used ONCE, as the "code" on the sign-up screen, to create the admin account
# with the email above. Not needed after that account exists.
ADMIN_SETUP_CODE=

# Optional: audio/video calls work on most home networks with the free Google STUN servers built in. Some networks
# (strict offices, some mobile data) also need a TURN relay. If you have one, fill these in.
# TURN_URL=turn:turn.example.com:3478
# TURN_USERNAME=
# TURN_CREDENTIAL=

# Where encrypted uploads are stored. Default: server/uploads. On a host with a persistent disk, use the disk path.
# UPLOAD_DIR=/var/data/uploads

# How many proxies are in front of the server: 1 = just the host (default), 2 = Cloudflare in front of the host.
# TRUST_PROXY=1

# Where the React dev server runs (only used for CORS in development).
CLIENT_ORIGIN=http://localhost:5173

# Largest attachment, in megabytes. (Also set MAX_FILE_MB in client/src/components/ChatWindow.jsx to match.)
MAX_FILE_MB=100
